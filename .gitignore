# Python
__pycache__/
# Virtual environments. The README tells people to create .venv
# inside the checkout, so this must never be committed.
.venv/
venv/
env/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Testing
.pytest_cache/

# Linting
.ruff_cache/

# macOS
.DS_Store
._*

# Logs
*.log

# User output (generated by running the app)
de_analysis_results/
gene_expression_results/

# Simulation output
dev/simulations/results/
dev/simulations/Heart Logo/

# Large data files (h5ad)
*.h5ad
!kosmic/reference/tutorial/tutorial_dataset.h5ad

# Editor / assistant tooling (machine-local: launch.json hardcodes
# an interpreter path, and the lock file is per-session state)
# Claude Code: the shared project setting is committed (it turns off the
# AI attribution byline for everyone); everything else in there is local.
.claude/*
!.claude/settings.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# MkDocs build output (mkdocs.yml -> site/)
site/

# The tutorial dataset is synthetic and regenerated on first run
# (kosmic/gui/help/tutorial/data.py); never commit it.
kosmic/reference/tutorial/tutorial_dataset.h5ad
kosmic/reference/tutorial/tutorial_dataset.version

# PyInstaller output (packaging/kosmic.spec)
build/
dist/

